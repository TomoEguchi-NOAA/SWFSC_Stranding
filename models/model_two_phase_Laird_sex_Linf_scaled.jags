# Scaled age growth model

model {
  # ===========================================================
  # SPECIES & SEX LEVEL CALCULATIONS
  # ===========================================================
  for (s in 1:N_species) {
    for (x in 1:N_sex) {
      # L0 remains anchored at birth (t=0)
      Lc[s, x] <- L0[s] * exp((a1[s, x] / alpha1[s, x]) * (1 - exp(-alpha1[s, x] * tc[s, x])))
      
      # Safety Net
      denom[s, x] <- max(log(L_inf[s, x]) - log(Lc[s, x]), 0.001)
      alpha2[s, x] <- a2[s, x] / denom[s, x]
    }
  }

  # ===========================================================
  # OBSERVATION MODEL
  # ===========================================================
  for (i in 1:N_growth) {
    # Phase 1: Juvenile Curve
    mu1[i] <- L0[sp_growth[i]] * exp((a1[sp_growth[i], sex_growth[i]] / alpha1[sp_growth[i], sex_growth[i]]) * (1 - exp(-alpha1[sp_growth[i], sex_growth[i]] * age_scaled[i])))
    
    # Phase 2: Adult Curve (Calculated in background even if skipped)
    mu2[i] <- Lc[sp_growth[i], sex_growth[i]] * exp((a2[sp_growth[i], sex_growth[i]] / alpha2[sp_growth[i], sex_growth[i]]) * (1 - exp(-alpha2[sp_growth[i], sex_growth[i]] * (age_scaled[i] - tc[sp_growth[i], sex_growth[i]]))))
    
    # Phase Switch (0 or 1)
    is_phase2[i] <- step(age_scaled[i] - tc[sp_growth[i], sex_growth[i]])
    
    # Two-Phase Prediction
    mu_two_phase[i] <- (1 - is_phase2[i]) * mu1[i] + is_phase2[i] * mu2[i]
    
    # THE HARD SWITCH: Dictates if Phase 2 is used at all based on Species
    mu[i] <- (1 - has_phase2[sp_growth[i]]) * mu1[i] + has_phase2[sp_growth[i]] * mu_two_phase[i]
    
    # Phase-specific precision
    tau_i[i] <- (1 - is_phase2[i]) * tau_juv + is_phase2[i] * tau_adult
    
    length_growth[i] ~ dnorm(mu[i], tau_i[i])
    loglik[i] <- logdensity.norm(length_growth[i], mu[i], tau_i[i])
  }

  # ===========================================================
  # PRIORS
  # ===========================================================
  for (s in 1:N_species) {
    L0[s] ~ dnorm(mu_L0_data[s], tau_L0_data[s]) T(0, )
    
    for (x in 1:N_sex) {
      a1[s, x]     ~ dlnorm(mu_a1[x], tau_a1)
      alpha1[s, x] ~ dlnorm(mu_alpha1[x], tau_alpha1)
    }
  }

  # BIOLOGICAL PRIORS: Species 1 and 3 (Two-Phase)
  for (s in c(1, 3)) {
    for (x in 1:N_sex) {
      tc[s, x]     ~ dnorm(mu_tc[x], tau_tc) T(0, )
      a2[s, x]     ~ dlnorm(mu_a2[s, x], tau_a2)
      L_inf[s, x]  ~ dnorm(mu_L_inf[x], tau_L_inf) T(150, 260) 
    }
  }

  # DUMMY PRIORS: Species 2 (Single-Phase)
  for (x in 1:N_sex) {
    tc[2, x]    ~ dnorm(10, 1)      
    a2[2, x]    ~ dlnorm(0, 1)      
    L_inf[2, x] ~ dnorm(200, 0.001) 
  }

  # GLOBAL HYPER-MEANS
  for (x in 1:N_sex) {
    mu_a1[x] ~ dnorm(0, 0.001)
    mu_alpha1[x] ~ dnorm(0, 0.001)
    mu_tc[x] ~ dnorm(0.6, 0.1) T(0, ) # Centered around 0.6 because age is scaled by 10!
    mu_L_inf[x] ~ dnorm(200, 0.001)
    
    for (s in 1:N_species) {
      mu_a2[s, x] ~ dnorm(0, 0.001)
    }
  }
  
  # HYPER-STANDARD DEVIATIONS (Uniform distributions)
  s_a1 ~ dunif(0, 10)
  tau_a1 <- 1 / (s_a1 * s_a1)
  s_alpha1 ~ dunif(0, 10)
  tau_alpha1 <- 1 / (s_alpha1 * s_alpha1)
  s_tc ~ dunif(0, 10)
  tau_tc <- 1 / (s_tc * s_tc)
  s_a2 ~ dunif(0, 10)
  tau_a2 <- 1 / (s_a2 * s_a2)
  s_L_inf ~ dunif(0, 50)
  tau_L_inf <- 1 / (s_L_inf * s_L_inf)

  # RESIDUAL VARIANCES
  s_juv ~ dunif(0, 30)
  tau_juv <- 1 / (s_juv * s_juv)
  s_adult ~ dunif(0, 50)
  tau_adult <- 1 / (s_adult * s_adult)
}
